{
  "version": "1.5",
  "status": "adopted_for_implementation",
  "baseline_definition": "min(solar_lcoe, wind_lcoe) < coal_operating_cost_floor",
  "spatial_resource": {
    "same_country_only": true,
    "prespecified_reporting_radii_km": [30, 45, 60],
    "control_radius_km": {
      "minimum": 30,
      "maximum": 60,
      "step": 1,
      "calculation": "direct raster extraction at every displayed radius"
    },
    "central_radius_km": 45,
    "prespecified_reporting_percentiles": [50, 90, 100],
    "control_percentile": {
      "minimum": 0,
      "maximum": 100,
      "step": 1,
      "minimum_definition": "P0 is the minimum valid same-country raster cell",
      "maximum_definition": "P100 is the maximum valid same-country raster cell",
      "calculation": "direct empirical spatial quantile at every displayed percentile"
    },
    "central_cell_statistic": "p90"
  },
  "wind": {
    "gross_to_net_loss_fractions": [0.1, 0.15, 0.2],
    "control_loss_fraction": {
      "minimum": 0.1,
      "maximum": 0.2,
      "step": 0.01
    },
    "central_loss_fraction": 0.15,
    "formula": "wind_net_capacity_factor = wind_gross_capacity_factor * (1 - wind_loss_fraction)"
  },
  "coal_operating_cost": {
    "prespecified_reporting_percentiles": [10, 50, 90],
    "control_percentile": {
      "minimum": 0,
      "maximum": 100,
      "step": 1,
      "calculation": "empirical percentile of monthly World Bank coal benchmark prices from 2023M01 through 2025M12; P0 and P100 are the observed minimum and maximum monthly benchmark prices; unit heat rate and assigned all-in O&M remain fixed"
    },
    "central_percentile": 50
  },
  "financing": {
    "wacc_reduction_percentage_points": {
      "minimum": 0,
      "maximum": 10,
      "step": 0.5,
      "floor": 0,
      "formula": "adjusted_wacc = max(0, baseline_wacc - reduction_percentage_points / 100)"
    }
  },
  "renewable_capex": {
    "multiplier": {
      "minimum": 0.6,
      "maximum": 1.4,
      "step": 0.05,
      "central": 1.0,
      "formula": "scenario_capex = source_capex * multiplier"
    }
  },
  "battery_storage": {
    "scope": "separate_sensitivity_layer",
    "technology": "utility_scale_lithium_ion",
    "duration_hours": [4],
    "central_duration_hours": 4,
    "stored_energy_shares": [0.0, 0.25, 0.5, 1.0],
    "control_stored_energy_share": {
      "minimum": 0.0,
      "maximum": 1.0,
      "step": 0.01
    },
    "capex_source": "PyPSA-Earth battery-cost series and its cited sources; nominal 2025 value approved by the study principal investigator",
    "capex_cost_boundary": "four-hour grid-battery capital cost per kWh; not LCOS",
    "capex_geographic_scope": "global benchmark",
    "capex_application": "nominal 2025 default for the global storage-cost sensitivity",
    "technical_assumptions_source": "NREL/TP-6A40-93281",
    "capex_2025_usd_per_kwh": {
      "nominal_2025": 164.44
    },
    "pypsa_earth_reference_usd_per_kwh": {
      "nominal_2025": 164.44,
      "effective_2025_two_year_build_lag": 237.5,
      "2050": {
        "p10": 61.2,
        "median": 99.3,
        "p90": 201.7
      }
    },
    "iea_weo_reference_usd_per_kwh": {
      "currency_basis": "2024 USD",
      "2024": 150.0,
      "2050": {
        "current_policies": 90.0,
        "stated_policies": 90.0,
        "net_zero_emissions": 80.0
      }
    },
    "central_capex_case": "nominal_2025",
    "control_capex_2025_usd_per_kwh": {
      "minimum": 111.03,
      "maximum": 359.8,
      "default": 164.44,
      "step": 0.01,
      "display_precision": 2,
      "minimum_anchor": "NREL 2050 low projection for a complete four-hour system",
      "maximum_anchor": "NREL 2025 high projection for a complete four-hour system",
      "calculation": "exploratory dashboard envelope in constant 2025 USD/kWh to the nearest cent; it is not a confidence interval; the slider opens at the nominal 2025 PyPSA-Earth value of 164.44 USD/kWh"
    },
    "fixed_om_fraction_of_capex_per_kw_year": 0.04,
    "variable_om_usd_per_mwh": 0.0,
    "project_life_years": 15,
    "round_trip_efficiency": 0.85,
    "cycles_per_year": 365,
    "wacc_rule": "paired_country_technology_real_after_tax_renewable_wacc_proxy",
    "charging_cost_rule": "paired_renewable_lcoe"
  },
  "formulas": {
    "battery_capex_per_kw": "capex_usd_per_kwh * duration_hours",
    "battery_fom_per_kw_year": "fixed_om_fraction * battery_capex_per_kw",
    "annual_discharged_mwh_per_kw": "duration_hours * cycles_per_year / 1000",
    "storage_asset_lcos": "(battery_capex_per_kw * crf + battery_fom_per_kw_year) / annual_discharged_mwh_per_kw",
    "charging_lcos": "renewable_lcoe / round_trip_efficiency",
    "total_lcos": "storage_asset_lcos + charging_lcos",
    "hybrid_lcoe": "(1 - stored_energy_share) * renewable_lcoe + stored_energy_share * total_lcos"
  },
  "interpretation": {
    "storage_is_not_in_baseline": true,
    "firm_replacement_claim": false,
    "hourly_dispatch_model": false,
    "global_battery_cost_is_benchmark_sensitivity": true,
    "lazard_2026_role": "external_validation_only"
  }
}
